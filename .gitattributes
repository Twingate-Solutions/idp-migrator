# Normalize line endings: store as LF in repo, checkout as-is on all platforms
* text=auto eol=lf

# Explicitly LF for source files
*.py text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.cfg text eol=lf
*.ini text eol=lf
*.spec text eol=lf
*.sh text eol=lf

# Binary files — no line ending conversion
*.png binary
*.jpg binary
*.ico binary
*.pyc binary
